# ==============================================================================
# Edge Infrastructure Orchestrator - Environment Configuration Template
# Copy this file to .env before deploying: cp env.example .env
# ==============================================================================

# Timezone & System Settings
TZ=America/Guayaquil
NODE_ENV=production

# Database Credentials (Simulated for Portfolio)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=SuperSecurePassword2026!
MONGO_APP_USER=iot_service
MONGO_APP_PASSWORD=AppServiceSecret2026!
MONGO_DATABASE=telemetry_production

# Ports Mapping
MONGO_PRIMARY_PORT=27017
MONGO_REPLICA_PORT=27018
MONGO_HISTORIC_PORT=27019
API_SERVICE_PORT=8080
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Kafka & Debezium Streaming
KAFKA_PORT=9092
ZOOKEEPER_PORT=2181
KAFKA_CONNECT_PORT=8083

# Resource Limits Defaults
PRIMARY_DB_CPU_LIMIT=1.5
PRIMARY_DB_MEM_LIMIT=2G
APP_API_CPU_LIMIT=1.0
APP_API_MEM_LIMIT=1G

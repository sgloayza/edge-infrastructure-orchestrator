# Nginx Reverse Proxy Configuration for Edge Devices (ARM64 / x86_64)
# Managed by Ansible - Do not edit manually

user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
    use epoll;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for" '
                    'rt=$request_time';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    client_max_body_size {{ client_max_body_size }};

    gzip on;
    gzip_disable "msie6";
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    upstream backend_upstream {
        server {{ backend_api_host }}:{{ backend_api_port }} max_fails=3 fail_timeout=10s;
        keepalive 32;
    }

    server {
        listen {{ edge_http_port }};
        server_name _;

        # Healthcheck endpoint for local monitoring
        location /healthz {
            access_log off;
            return 200 "OK\n";
            add_header Content-Type text/plain;
        }

        # Reverse Proxy to Telemetry Web API
        location / {
            proxy_pass http://backend_upstream;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_connect_timeout {{ proxy_connect_timeout }};
            proxy_read_timeout {{ proxy_read_timeout }};
            proxy_send_timeout {{ proxy_send_timeout }};
        }
    }
}
